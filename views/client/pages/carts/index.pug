extends ../../layouts/default.pug
include ../../mixins/moment.pug
include ../../mixins/alert.pug

block head
  title Your Shopping Cart | Tour Management
  link(rel="stylesheet" href="/client/css/cart.css")

block main
  .container.my-5
    // Flash Messages
    +alert-success(3000)
    +alert-error(3000)

    .d-flex.align-items-center.justify-content-between.mb-4
      h2.fw-bold.text-dark.m-0
        i.fa-solid.fa-cart-shopping.me-2.text-primary
        | Your shopping cart
      if cart && cart.items && cart.items.length > 0
        span.badge.bg-primary-subtle.text-primary.fs-6.px-3.py-2.rounded-pill
          | #{cart.totalQuantity} Tour In The Cart

    if !cart || !cart.items || cart.items.length === 0
      // Cart Empty
      .text-center.py-5.bg-white.rounded-4.shadow-sm.my-4
        .mb-4
          i.fa-solid.fa-basket-shopping.text-muted(style="font-size: 5rem; opacity: 0.3;")
        h4.fw-bold.text-secondary Your shopping cart is empty!
        p.text-muted.mb-4 Discover more exciting tours and choose the trip that's right for you.
        a.btn.btn-primary.btn-lg.rounded-pill.px-5.fw-semibold.shadow-sm(href="/tours")
          i.fa-solid.fa-compass.me-2
          | Discover now
    else
      // DANH SÁCH SẢN PHẨM & TÓM TẮT ĐƠN HÀNG
      .row.g-4
        // CỘT TRÁI: Bảng danh sách Tour trong giỏ
        .col-12.col-lg-8
          .card.border-0.shadow-sm.rounded-4.overflow-hidden
            .card-body.p-0
              .table-responsive
                table.table.table-hover.align-middle.mb-0
                  thead.bg-light.text-uppercase.fs-7.text-muted
                    tr
                      th.py-3.ps-4(scope="col" style="width: 45%;") Tour
                      th.py-3.text-center(scope="col" style="width: 20%;") Quantity
                      th.py-3.text-end(scope="col" style="width: 20%;") Total Amount
                      th.py-3.text-center(scope="col" style="width: 15%;") Operation
                  tbody
                    each item in cart.items
                      tr(data-item-id=item.id)
                        // Thông tin Tour
                        td.ps-4.py-3
                          .d-flex.align-items-center.gap-3
                            img.rounded-3.object-fit-cover.shadow-sm(
                              src=(item.tour.images && item.tour.images.length > 0 ? item.tour.images[0] : '/images/default-tour.jpg')
                              alt=item.tour.title
                              style="width: 80px; height: 60px;"
                            )
                            div
                              a.fw-bold.text-dark.text-decoration-none.line-clamp-2.mb-1(
                                href=`/tours/detail/${item.tour.slug}`
                              )= item.tour.title
                              .text-muted.small
                                i.fa-solid.fa-barcode.me-1
                                | #{item.tour.code}
                              .text-primary.fw-semibold.small.mt-1
                                | #{item.priceSpecial.toLocaleString('vi-VN')}đ / guest

                        // Điều chỉnh Số lượng
                        td.text-center.py-3
                          .input-group.input-group-sm.mx-auto(style="max-width: 110px;")
                            button.btn.btn-outline-secondary.btn-update-quantity(
                              type="button"
                              data-action="decrease"
                              data-id=item.id
                            ) -
                            input.form-control.text-center.fw-bold.input-quantity(
                              type="number"
                              value=item.quantity
                              min="1"
                              max=item.tour.stock
                              data-id=item.id
                              data-price=item.priceSpecial
                            )
                            button.btn.btn-outline-secondary.btn-update-quantity(
                              type="button"
                              data-action="increase"
                              data-id=item.id
                            ) +

                        // Thành tiền từng mục
                        td.text-end.py-3.pe-3.fw-bold.text-danger.fs-6
                          span.item-total-price(data-id=item.id)
                            | #{item.totalPrice.toLocaleString('vi-VN')}đ

                        // Nút Xóa
                        td.text-center.py-3
                          button.btn.btn-light.btn-sm.rounded-circle.text-danger.btn-delete-item(
                            type="button"
                            data-id=item.id
                            title="Delete Tour"
                          )
                            i.fa-solid.fa-trash-can

        // CỘT PHẢI: Sticky Checkout Summary Card
        .col-12.col-lg-4
          .card.border-0.shadow-sm.rounded-4.p-4.sticky-top(style="top: 90px; z-index: 10;")
            h5.fw-bold.text-dark.mb-4 Order Summary

            .d-flex.justify-content-between.align-items-center.mb-3
              span.text-muted Provisional calculation
              span.fw-bold.text-dark#cartSubtotal(data-value=cart.totalPrice)
                | #{cart.totalPrice.toLocaleString('vi-VN')}đ

            .d-flex.justify-content-between.align-items-center.mb-3
              span.text-muted Discount
              span.fw-bold.text-success#cartDiscount(data-value=0)
                | 0đ

            hr.my-3.text-muted.opacity-25

            .d-flex.justify-content-between.align-items-center.mb-4
              span.fw-bold.fs-5.text-dark Total amount
              div.text-end
                .fw-bold.fs-4.text-danger#cartTotal(data-value=cart.totalPrice)
                  | #{cart.totalPrice.toLocaleString('vi-VN')}đ
                .text-muted.small (VAT included)

            // Form Mã Giảm Giá
            .mb-4
              label.form-label.small.fw-bold.text-secondary Promo code
              .input-group
                input.form-control#inputVoucher(
                  type="text"
                  placeholder="Enter discount code"
                )
                button.btn.btn-outline-primary#btnApplyVoucher(type="button") Apply

            // Nút Thanh Toán
            a.btn.btn-gradient-primary.w-100.py-3.fw-bold.rounded-3.shadow-sm.fs-6(href="/checkout")
              i.fa-solid.fa-credit-card.me-2
              | Book a tour

block script
  script(src="/client/js/cart.js")